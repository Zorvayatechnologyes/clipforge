# Copy to .env and edit. Every value below is optional.

# --- transcription ---
# tiny | base | small | medium | large-v3
CLIPFORGE_WHISPER_MODEL=small
# auto | cpu | cuda
CLIPFORGE_WHISPER_DEVICE=auto
# int8 | int8_float16 | float16 | float32
CLIPFORGE_WHISPER_COMPUTE=int8
# leave empty for auto-detect, or force e.g. en / hi
CLIPFORGE_LANGUAGE=

# --- what to cut ---
CLIPFORGE_MIN_CLIP=18
CLIPFORGE_MAX_CLIP=55
CLIPFORGE_MAX_CLIPS=6
# spread the clips across the whole video instead of taking them all from
# the loudest few minutes
CLIPFORGE_SPREAD=true
CLIPFORGE_VERTICAL=true
CLIPFORGE_SUBTITLES=true
CLIPFORGE_SUB_FONT=DejaVu Sans

# --- local LLM (optional) ---
CLIPFORGE_USE_LLM=true
CLIPFORGE_OLLAMA_URL=http://127.0.0.1:11434
CLIPFORGE_OLLAMA_MODEL=qwen2.5:7b-instruct

# --- download ---
CLIPFORGE_MAX_SOURCE_HEIGHT=1080
# needed for age-restricted videos: chrome | firefox | edge | brave
CLIPFORGE_COOKIES_FROM_BROWSER=
# Netscape cookies.txt. Required when the engine is hosted on a cloud server,
# because YouTube refuses to serve datacenter IPs.
CLIPFORGE_COOKIES_FILE=
CLIPFORGE_KEEP_SOURCE=false

# --- paths / server ---
CLIPFORGE_WORK=data/work
CLIPFORGE_OUTPUT=data/clips
CLIPFORGE_HOST=127.0.0.1
CLIPFORGE_PORT=8000

# origins allowed to call this API from a browser.
# "*" is fine locally; set it to your site's URL when you host the page elsewhere
# e.g. https://clipforge.netlify.app
CLIPFORGE_ALLOWED_ORIGINS=*
